{
    "name": "@trezor/evolu-relay",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "printf \"\\e[31mDEPRECATION WARNING: This is only for Backward Compatibility.\n\\e[0m\" && node dist/src/index.js",
        "start-quota-manager": "node dist/src/quotaManager/index.js",
        "start-evolu-relay": "node dist/src/evoluRelay/index.js",
        "start-metrics": "node dist/src/metrics/index.js",
        "dev": "tsx watch src/index.ts",
        "test": "vitest",
        "format": "prettier --write src",
        "format:check": "prettier --check src",
        "type-check": "tsc --build tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@evolu/common": "8.10.0",
        "@evolu/nodejs": "4.0.0",
        "@trezor/device-authenticity": "10.0.0-beta.1",
        "@trezor/protobuf": "10.0.0-beta.1",
        "dotenv": "^17.4.2",
        "fastify": "^5.12.3",
        "kysely": "^0.29.5",
        "pg": "^8.23.0",
        "prom-client": "^15.1.3",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.4.1",
        "@types/pg": "^8.23.1",
        "better-sqlite3": "^12.11.1",
        "eslint": "^10.10.0",
        "eslint-plugin-import": "^2.32.0",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    },
    "packageManager": "yarn@4.18.0"
}
